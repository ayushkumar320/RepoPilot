# ─── Environment ───────────────────────────────────────────────────────────
REPOPILOT_ENV=development
REPOPILOT_LOG_LEVEL=INFO
REPOPILOT_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Generate with: openssl rand -hex 32
REPOPILOT_SESSION_SECRET=repopilot-development-session-secret
# Set to true when the API is served over HTTPS in production.
REPOPILOT_SESSION_COOKIE_SECURE=false

# ─── LLM providers ─────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional second fallback before Hugging Face
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Hugging Face Inference Providers — final LLM fallback.
# Free user token at https://huggingface.co/settings/tokens (read scope is fine).
# The OpenAI-compatible gateway routes to underlying providers (Cerebras,
# Together, Replicate, etc.) automatically.
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Embeddings run **in-process** via sentence-transformers.
# Weights download from huggingface.co into ~/.cache/huggingface on first use
# (~250MB). No Ollama daemon, no Docker, no HTTP.
HUGGINGFACE_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ─── LLM provider behaviour ────────────────────────────────────────────────
LLM_CACHE_PATH=.cache/llm.sqlite
LLM_MAX_429_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8.0
LLM_REQUEST_TIMEOUT_SECONDS=60

# ─── GitHub (Lane A — Phase 5) ─────────────────────────────────────────────
# Read-only PAT, `public_repo` scope. Shared server-side resource per docs/06 S7.
GITHUB_PAT=

# ─── Datastores ────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
REDIS_URL=redis://localhost:6379/0

# ─── LangSmith (optional observability) ────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repopilot-dev

LLM_HF_CHAT_FALLBACK=1
