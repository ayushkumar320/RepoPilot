NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000

# --- GitHub sign-in (optional; unset AUTH_GITHUB_ID disables it entirely) ---
# OAuth app callback URL: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Must be byte-identical to REPOPILOT_SESSION_SECRET on the API side.
REPOPILOT_SESSION_SECRET=repopilot-development-session-secret
# v5 name for the same thing; keep both in step with your OAuth app's callback
# host. `localhost` and `127.0.0.1` are NOT interchangeable — GitHub OAuth apps
# allow one callback URL, and the two hosts have separate cookie jars.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
