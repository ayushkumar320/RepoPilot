{
  "info": {
    "_postman_id": "8ef4a3ef-ff0b-4b3e-8eb3-21f2f0f9a4d1",
    "name": "RepoPilot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing the RepoPilot backend independently from the frontend."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "repoUrl",
      "value": "https://github.com/pallets/flask"
    },
    {
      "key": "repoId",
      "value": ""
    },
    {
      "key": "chunkId",
      "value": "chunk-123"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Repo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 202', function () {",
              "  pm.response.to.have.status(202);",
              "});",
              "const data = pm.response.json();",
              "if (data.repo_id) {",
              "  pm.collectionVariables.set('repoId', data.repo_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"repo_url\": \"{{repoUrl}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Repo Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repos/{{repoId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repos",
            "{{repoId}}",
            "status"
          ]
        }
      },
      "response": []
    },
    {
      "name": "First Impression Stream",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/repos/{{repoId}}/first-impression",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repos",
            "{{repoId}}",
            "first-impression"
          ]
        },
        "description": "SSE endpoint. In Postman, use Send and inspect the streamed response body."
      },
      "response": []
    },
    {
      "name": "Draft Intent (free-text persona)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"raw_text\": \"I'm writing a migration guide and need the breaking changes\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/intent",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "intent"
          ]
        },
        "description": "Turns a free-text persona into a structured IntentProfile you can send with /ask."
      },
      "response": []
    },
    {
      "name": "Ask as Contributor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Where should I start if I care about routing?\",\n  \"intent_profile\": {\n    \"raw_text\": \"I want to contribute to this project and need to know where a change would go\",\n    \"modality_weights\": {\n      \"change\": 1,\n      \"understand\": 0.6\n    },\n    \"focus_keywords\": [\n      \"entry points\",\n      \"tests\"\n    ],\n    \"audience_framing\": \"a first-time outside contributor preparing a pull request\",\n    \"output_shape_preference\": \"ranked_list\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repos/{{repoId}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repos",
            "{{repoId}}",
            "ask"
          ]
        },
        "description": "Same repo, same question \u2014 compare this answer with 'Ask as Competitor'."
      },
      "response": []
    },
    {
      "name": "Ask as Competitor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Where should I start if I care about routing?\",\n  \"intent_profile\": {\n    \"raw_text\": \"I am evaluating this project against a competing product\",\n    \"modality_weights\": {\n      \"evaluate\": 1,\n      \"compare\": 0.8\n    },\n    \"focus_keywords\": [\n      \"features\",\n      \"limits\",\n      \"integrations\"\n    ],\n    \"audience_framing\": \"a product strategist at a competing company\",\n    \"output_shape_preference\": \"ranked_list\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repos/{{repoId}}/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repos",
            "{{repoId}}",
            "ask"
          ]
        },
        "description": "The persona changes ordering and emphasis, never the underlying claims."
      },
      "response": []
    },
    {
      "name": "Get Chunk",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/chunks/{{chunkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chunks",
            "{{chunkId}}"
          ]
        },
        "description": "Replace {{chunkId}} with a real chunk id returned by your running backend if needed."
      },
      "response": []
    },
    {
      "name": "Dev SSE Idle",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/__dev/sse-idle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "__dev",
            "sse-idle"
          ]
        },
        "description": "Development-only SSE endpoint for confirming event-stream behavior."
      },
      "response": []
    }
  ]
}
